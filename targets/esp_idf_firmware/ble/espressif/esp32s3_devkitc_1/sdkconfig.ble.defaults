# Fit every ESP32-S3-DevKitC-1 flash option (N8R8 and larger).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition.csv"

# TinyUSB owns the native USB port; logs stay on the UART bridge port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n

# The host's Bluetooth stack drives the controller over HCI: no on-chip host.
# CONFIG_BT_NIMBLE_ENABLED is not set
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CTRL_HCI_MODE_VHCI=y

# Standard USB Bluetooth class with one zero-bandwidth SCO alternate.
CONFIG_TINYUSB_BTH_ENABLED=y
CONFIG_TINYUSB_BTH_ISO_ALT_COUNT=1
# Resubmit IN packets queued while the bus was suspended.
CONFIG_TINYUSB_RESUME_CALLBACK=y
# CONFIG_TINYUSB_CDC_ENABLED is not set
# CONFIG_TINYUSB_MSC_ENABLED is not set
