load("@gizos//tools/bazel/firmware:firmware.bzl", "firmware_version")
load("@gizos//tools/bazel/firmware:firmware_components.bzl", "firmware_lib_component")
load("@gizos//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("@gizos//tools/bazel/firmware:target_task_policy.bzl", "esp_target_task_policy")
load("@gizos//tools/bazel/native/esp_idf:esp_idf.bzl", "esp_idf_firmware")

package(default_visibility = ["//visibility:public"])

# ble on the official ESP32-S3-DevKitC-1, using the GizOS board package.
# Build: bazel build --config=esp32s3 //targets/esp_idf_firmware/ble/espressif/esp32s3_devkitc_1:firmware

firmware_version(
    name = "version",
    value = "0.1.0",
)

esp_target_task_policy(
    name = "task_policy",
    default_policy = "4  any  4096  psram",
    graph = [":launcher"],
    policies = [
        # Relays HCI between USB and the controller; keep it responsive.
        "ble/hci  10  any  4096  internal",
        "$h2peer/net  7  0  4096  psram",
        "$h2peer/udp  7  0  4096  psram",
        "$runtime/input  default",
        "$runtime/nfc  default",
    ],
)

firmware_lib_component(
    name = "firmware_lib",
    deps = [
        "//apps/ble",
        "//libs/bt/hci",
        # Generated task policy routes task names through h2_trie.
        "@gizos//libs/container/trie",
        "@gizos//libs/net/wifi_sta",
        "@gizos//libs/runtime",
        "@gizos//libs/sync/atomic",
        "@gizos//pal:unsupported",
        "@gizos//pal/providers/backends/corehttp",
        "@gizos//pal/providers/backends/h2peer",
        "@gizos//pal/providers/backends/h2sctp",
    ],
)

firmware_native_component(
    name = "launcher",
    srcs = ["main/main.c"],
    component_directory = "targets/esp_idf_firmware/ble/espressif/esp32s3_devkitc_1/main",
    component_name = "main",
    data = [
        "main/CMakeLists.txt",
        "main/idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        ":firmware_lib",
        "//libs/bt/esp_vhci",
        "//libs/usb/esp_tinyusb_bth",
        "@gizos//boards/espressif/esp32s3_devkitc_1/esp32s3",
        "@gizos//libs/runtime",
        "@gizos//native_component_src/esp-idf6.x/h2_pal_core",
        "@gizos//native_component_src/esp-idf6.x/zlib",
    ],
)

esp_idf_firmware(
    name = "firmware",
    srcs = [
        "CMakeLists.txt",
        "main/CMakeLists.txt",
        "main/idf_component.yml",
        "main/main.c",
        "sdkconfig.ble.defaults",
    ],
    board = "devkit",
    graph = [":launcher"],
    partition = "partition.csv",
    project = "CMakeLists.txt",
    project_name = "otg_ble",
    target = "esp32s3",
    task_policy = ":task_policy",
    version = ":version",
)
