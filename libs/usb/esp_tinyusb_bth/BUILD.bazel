load("@gizos//tools/bazel/firmware:native_component.bzl", "firmware_native_component")
load("@gizos//tools/bazel/platforms:compatibility.bzl", "HOST_TOOL_COMPATIBILITY")
load("@gizos//tools/bazel/toolchains:cc_options.bzl", "H2_C11_OPTS", "H2_WARNING_COPTS")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

# ESP-IDF component; compiled by the native SDK build, not by Bazel.
# Standard USB Bluetooth controller (class 0xE0) on TinyUSB.
firmware_native_component(
    name = "esp_tinyusb_bth",
    srcs = [
        "src/otg_bth_in.c",
        "src/otg_usb_bth.c",
    ],
    hdrs = [
        "include/otg_usb_bth.h",
        "src/otg_bth_in.h",
    ],
    component_directory = "libs/usb/esp_tinyusb_bth",
    component_name = "otg_usb_bth",
    data = [
        "CMakeLists.txt",
        "idf_component.yml",
    ],
    tags = ["manual"],
    deps = [
        "//libs/bt/hci",
        "@gizos//pal",
    ],
)

# IN-endpoint ownership, free of TinyUSB so host tests can drive it.
cc_library(
    name = "in_endpoint",
    testonly = True,
    srcs = ["src/otg_bth_in.c"],
    hdrs = ["src/otg_bth_in.h"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    includes = ["src"],
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = ["//libs/bt/hci"],
)

cc_test(
    name = "in_endpoint_test",
    srcs = ["tests/otg_bth_in_test.c"],
    conlyopts = H2_C11_OPTS,
    copts = H2_WARNING_COPTS,
    target_compatible_with = HOST_TOOL_COMPATIBILITY,
    deps = [":in_endpoint"],
)
