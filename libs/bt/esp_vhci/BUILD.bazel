load("@gizos//tools/bazel/firmware:native_component.bzl", "firmware_native_component")

package(default_visibility = ["//visibility:public"])

# ESP-IDF component; compiled by the native SDK build, not by Bazel.
# Bluetooth LE controller reached through ESP-IDF's virtual HCI.
firmware_native_component(
    name = "esp_vhci",
    srcs = ["src/otg_esp_vhci.c"],
    hdrs = ["include/otg_esp_vhci.h"],
    component_directory = "libs/bt/esp_vhci",
    component_name = "otg_esp_vhci",
    data = ["CMakeLists.txt"],
    tags = ["manual"],
    deps = [
        "//libs/bt/hci",
        "@gizos//pal",
    ],
)
